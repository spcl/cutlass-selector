namespace autotuner_scheduler {

template <typename Arguments>
void configure_optimal_tile_scheduler(Arguments& args) {
    using RasterOrderOptions =
        typename cutlass::gemm::kernel::detail::PersistentTileSchedulerSm90Params::RasterOrderOptions;
    args.scheduler.raster_order = RasterOrderOptions::Heuristic;
    args.scheduler.max_swizzle_size = 8;
}

}  // namespace autotuner_scheduler

#define CUDA_CHECK(status)                                                                       \
    do {                                                                                         \
        cudaError_t error = (status);                                                            \
        if (error != cudaSuccess) {                                                              \
            std::cerr << "CUDA Error: " << cudaGetErrorString(error) << " at " << __FILE__ << ":" \
                      << __LINE__ << std::endl;                                                  \
            std::exit(EXIT_FAILURE);                                                             \
        }                                                                                        \
    } while (0)

#define CUTLASS_CHECK(status)                                                 \
    do {                                                                      \
        cutlass::Status error = (status);                                     \
        if (error != cutlass::Status::kSuccess) {                             \
            std::cerr << "CUTLASS Error at " << __FILE__ << ":" << __LINE__   \
                      << " (status=" << int(error) << "): "                   \
                      << cutlassGetStatusString(error) << std::endl;          \
            (void)cudaGetLastError();                                         \
            return static_cast<int>(error);                                   \
        }                                                                     \
    } while (0)

